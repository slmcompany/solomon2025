---
import Layout from '../../layouts/Layout.astro'
import Image from 'astro/components/Image.astro'
import Headercategory from '../../components/Headercategory.astro'
import { Image as AstroImage } from 'astro:assets';

// Import hình ảnh từ thư mục assets
import headerImage from '../../assets/images/1135524586-1024x1024.jpg';
import dieCastingIcon from '../../assets/images/die-casting-icon.svg';
import investmentCastingIcon from '../../assets/images/investment-casting-icon.svg';
import sandCastingIcon from '../../assets/images/sand-casting-icon.svg';

const title = "Metal Casting Services"
const content = "Solomon Industries LLC specializes in high-quality metal casting services, offering precision die casting, investment casting, and sand casting solutions. Our advanced facilities and experienced team ensure superior quality castings for various industries including automotive, aerospace, and industrial equipment manufacturing."

const features = [
    {
        name: 'Die Casting',
        description: 'High-pressure die casting for aluminum, zinc, and magnesium alloys with tight tolerances and excellent surface finish.',
        icon: dieCastingIcon
    },
    {
        name: 'Investment Casting',
        description: 'Precision investment casting for complex geometries and detailed components requiring superior surface quality.',
        icon: investmentCastingIcon
    },
    {
        name: 'Sand Casting',
        description: 'Traditional and automated sand casting processes for large components and prototype production.',
        icon: sandCastingIcon
    }
]

const capabilities = [
    "Aluminum die casting up to 5kg",
    "Zinc die casting up to 2kg",
    "Investment casting for steel and stainless steel",
    "Sand casting for iron and non-ferrous alloys",
    "Secondary operations including machining and surface finishing",
    "Quality control and material testing",
    "Prototype to high-volume production"
]
---

<Layout title={title}>
    <Headercategory 
        title={title}
        content={content}
        imglink={headerImage}
    />

    <!-- Features Section -->
    <div class="bg-white py-16 sm:py-24 lg:py-32">
        <div class="mx-auto container px-4 sm:px-6 lg:px-8">
            <div class="mx-auto max-w-3xl text-center">
                <h2 class="text-base font-semibold leading-7 text-red-600">Advanced Capabilities</h2>
                <p class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
                    Comprehensive Metal Casting Solutions
                </p>
                <p class="mt-6 text-lg leading-8 text-gray-600">
                    Our metal casting services utilize advanced technology and skilled craftsmanship to deliver precision components for diverse applications.
                </p>
            </div>
            <div class="mt-20 max-w-lg sm:mx-auto md:max-w-none">
                <div class="grid grid-cols-1 gap-y-16 md:grid-cols-3 md:gap-x-12 md:gap-y-16">
                    {features.map((feature) => (
                        <div class="relative flex flex-col gap-6 sm:flex-row md:flex-col lg:flex-row">
                            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-red-600 text-white sm:shrink-0">
                                <AstroImage
                                    src={feature.icon}
                                    alt={feature.name}
                                    class="h-8 w-8"
                                    width={32}
                                    height={32}
                                />
                            </div>
                            <div class="sm:min-w-0 sm:flex-1">
                                <p class="text-lg font-semibold leading-8 text-gray-900">{feature.name}</p>
                                <p class="mt-2 text-base leading-7 text-gray-600">{feature.description}</p>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </div>

    <!-- Capabilities Section -->
    <div class="bg-gray-50 py-16 sm:py-24 lg:py-32">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <div class="mx-auto grid max-w-2xl grid-cols-1 gap-x-8 gap-y-16 sm:gap-y-20 lg:mx-0 lg:max-w-none lg:grid-cols-3">
                <div>
                    <h2 class="text-base font-semibold leading-7 text-red-600">Manufacturing Capabilities</h2>
                    <p class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">End-to-End Casting Services</p>
                    <p class="mt-6 text-base leading-7 text-gray-600">
                        From design assistance and material selection to finishing and quality testing, we offer comprehensive casting solutions tailored to your specific requirements.
                    </p>
                </div>
                <dl class="col-span-2 grid grid-cols-1 gap-x-8 gap-y-10 text-base leading-7 text-gray-600 sm:grid-cols-2 lg:gap-y-16">
                    {capabilities.map((capability) => (
                        <div class="relative pl-9">
                            <dt class="font-semibold text-gray-900">
                                <svg class="absolute top-1 left-0 h-5 w-5 text-red-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                                </svg>
                                {capability}
                            </dt>
                        </div>
                    ))}
                </dl>
            </div>
        </div>
    </div>
</Layout> 