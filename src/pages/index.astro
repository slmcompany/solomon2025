---
import Layout from '../layouts/Layout.astro'
import Featureproduct from '../components/Featureproduct.astro'
import Hero from '../components/Hero.astro'
import { Image } from 'astro:assets';

// Import các hình ảnh từ thư mục assets
import metalCastingImg from '../assets/images/stainless-steel-details-equipments-machinery-Medium.jpeg';
import metalFabricationImg from '../assets/images/industrial-machine-drilling-metal Medium.jpeg';
import groundScrewsImg from '../assets/images/ground_screws.jpg';
import quartzStoneImg from '../assets/images/quad_stone.jpeg';
import rubberImg from '../assets/images/rubber.jpg';
import plywoodImg from '../assets/images/plywood.jpg';

const featuretitle = 'Highlight Products'

const products = [
	{
		title: 'METAL CASTING',
		imageSrc: metalCastingImg,
		price: '$ 6.63/KGS',
		link: '/metal-casting',
		highlight: [],
		width: 600,
		height: 400,
		format: 'webp',
		alt: 'Metal Casting Product'
	},
	{
		title: 'METAL FABRICATION',
		imageSrc: metalFabricationImg,
		price: '$ 8.84/KGS',
		link: '/metal-fabrication',
		highlight: [],
		width: 600,
		height: 400,
		format: 'webp',
		alt: 'Metal Fabrication Product'
	},
	{
		title: 'GROUND SCREWS',
		imageSrc: groundScrewsImg,
		price: '$ 6.63/KGS',
		link: '/ground-screws',
		highlight: [],
		width: 600,
		height: 400,
		format: 'webp',
		alt: 'Ground Screws Product'
	},
	{
		title: 'QUARTZ STONE',
		imageSrc: quartzStoneImg,
		price: '$ 8.84/KGS',
		link: '/quartz-stone',
		highlight: [],
		width: 600,
		height: 400,
		format: 'webp',
		alt: 'Quartz Stone Product'
	},
	{
		title: 'RUBBER',
		imageSrc: rubberImg,
		price: '$ 8.84/KGS',
		link: '/rubber',
		highlight: [],
		width: 600,
		height: 400,
		format: 'webp',
		alt: 'Rubber Product'
	},
	{
		title: 'PLYWOOD',
		imageSrc: plywoodImg,
		price: '$ 8.84/KGS',
		link: '/plywood',
		highlight: [],
		width: 600,
		height: 400,
		format: 'webp',
		alt: 'Plywood Product'
	}
]
---

<Layout title="Quality - Professional - Trust">
	<Hero />
	<Featureproduct products={products} featuretitle={featuretitle} />

</Layout>
