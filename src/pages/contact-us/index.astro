---
import Layout from '../../layouts/Layout.astro'
import { Image } from 'astro:assets'
import FormContact from '../../components/FormQuotation'

const stats = [
	{
		title: 'SOLOMON INDUSTRIES LLC',
		address: '8512 Dakota Dr, Gaithersburg MD 20877',
		googlemap: 'https://maps.app.goo.gl/EFJ7oqpPkXScxSEPA',
		email: 'hiep@solomonindustries.us',
		phone: '+1 (301) 605-5600'
	}
]
---

<Layout title="Contact Us">
	<!-- Header Image Section -->
	<div class="relative">
		<img src="/images/shipping-and-importing-header.jpg" alt="Contact Us Header" class="w-full h-[400px] object-cover"/>
		<div class="absolute inset-0 bg-black bg-opacity-50 flex items-center justify-center">
			<h1 class="text-white text-5xl font-light">Contact Us</h1>
		</div>
	</div>

	<div class="relative bg-white">
		<div class="mx-auto container">
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 px-4 py-10">
				<!-- Left Column -->
				<div class="lg:col-span-8 relative z-20">
					<div class="max-w-xl relative z-20">
						<h1 class="text-6xl font-bold text-[#b42026] mb-6 relative z-20">Contact Us</h1>
						<p class="text-xl font-light leading-relaxed mb-8 relative z-20">
							Please contact us if you would like to arrange a free 20-minute call. We are delighted to consult with you to understand your specific requirements and suggest the best solutions for industrial products, including metal casting, metal fabrication, ground screws, quartz stone, rubber, and plywood.
						</p>

						<div class="border-2 border-dashed border-[#b42026] rounded-lg p-6 mb-8 bg-white/90 relative z-20">
							<h3 class="text-xl font-semibold text-[#b42026] mb-4">{stats[0].title}</h3>
							<div class="space-y-4">
								<div class="flex items-center gap-3">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
										<path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2-1a1 1 0 00-1 1v12a1 1 0 001 1h8a1 1 0 001-1V4a1 1 0 00-1-1H6z" clip-rule="evenodd" />
									</svg>
									<span>{stats[0].address}</span>
								</div>
								<div class="flex items-center gap-3">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
										<path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
									</svg>
									<a href={stats[0].googlemap} target="_blank" rel="noopener noreferrer" 
										class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-full shadow-sm text-white bg-[#b42026] hover:bg-[#9a1c21]">
										View on Google Maps
									</a>
								</div>
							</div>
						</div>
					</div>

					<!-- Map Image -->
					<div class="absolute top-[110px] right-0 z-10">
						<img 
							src="/images/maryland.webp" 
							alt="maryland map solomon" 
							height={481}
							width={900}
						/>
					</div>
					<div class="absolute top-[200px] right-[400px] z-30">
						<a href={stats[0].googlemap} target="_blank" rel="noopener noreferrer">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-orange-500" viewBox="0 0 20 20" fill="currentColor">
								<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
							</svg>
						</a>
					</div>
				</div>

				<!-- Right Column - Contact Form -->
				<div class="lg:col-span-4">
					<div class="bg-white rounded-lg shadow-lg border border-gray-100" 
						style={{ 
							background: "#fff", 
							zIndex: "20", 
							border: "solid 1px #0d0d0d0d", 
							borderRadius: "8px", 
							padding: "20px", 
							boxShadow: "0px 4px 8px rgba(0, 0, 0, 0.2)" 
						}}
					>
						<h1 class="text-[#b42026] font-light text-2xl mb-6">Get Quotation</h1>
						<FormContact client:load />
					</div>
				</div>
			</div>

			<!-- Contact Cards -->
			<div class="px-4 py-8 absolute bottom-20">
				<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
					<div class="bg-gradient-to-r from-[#8a1a1f] to-[#b42026] text-white rounded-lg p-6">
						<h3 class="text-xl font-medium mb-4">President: Hiep Nguyen (Mr.)</h3>
						<div class="space-y-2">
							<p class="flex items-center gap-2">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
									<path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
								</svg>
								<a href="https://wa.me/+13016055600" class="hover:underline">Tel: {stats[0].phone}</a>
							</p>
							<p class="flex items-center gap-2">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
									<path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
									<path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
								</svg>
								<a href="mailto:{stats[0].email}" class="hover:underline">Email: {stats[0].email}</a>
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</Layout>
