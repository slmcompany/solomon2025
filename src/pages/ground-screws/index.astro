---
import Layout from '../../layouts/Layout.astro'
import type Products from '../../interfaces/products.ts'
import Image from 'astro/components/Image.astro'
import { Image as AstroImage } from 'astro:assets';
import { getProductsByCategory } from '../../lib/local-data.ts'

// Import hình ảnh từ thư mục assets
import threadScrewImg from '../../assets/images/t-screw.jpg';
import helicalScrewImg from '../../assets/images/h-screw.jpg';
import groundScrewBanner from '../../assets/images/growscrew.png';
import filterIcon from '../../assets/images/tabler_filter.svg';
import sortIcon from '../../assets/images/ic_round-sort.svg';

// Lấy sản phẩm theo danh mục từ dữ liệu local
const Products = getProductsByCategory('screw');

const featuretitle = 'Feature Products'
const products = [
	{
		title: 'THREAD SCREWS',
		imageSrc: threadScrewImg,
		price: '$ 6.63/KGS',
		link: '/ground-screws/thread-screws',
		highlight: [
			{ text: 'Weight (KGS):', value: 'Min 4.42' },
			{ text: 'Welding method:', value: 'Automatic Robot' },
			{ text: 'Plating method:', value: 'Hot-dip galvanized' }
		],
		width: 600,
		height: 400,
		format: 'webp',
		alt: 'Thread Screws Product'
	},
	{
		title: 'HELICAL SCREWS',
		imageSrc: helicalScrewImg,
		price: '$ 8.84/KGS',
		link: '/ground-screws/helical-screws',
		highlight: [
			{ text: 'Weight (KGS):', value: 'Min 4.42' },
			{ text: 'Welding method:', value: 'Automatic Robot' },
			{ text: 'Plating method:', value: 'Hot-dip galvanized' }
		],
		width: 600,
		height: 400,
		format: 'webp',
		alt: 'Helical Screws Product'
	}
]
---

<Layout title="Ground Screws">
	<div class="relative bg-red-700">
		<div class="mx-auto container lg:grid lg:grid-cols-12 lg:gap-x-8 lg:px-8">
			<div class="px-6 pb-24 pt-10 sm:pb-32 lg:col-span-7 lg:px-0 lg:pb-56 lg:pt-48 xl:col-span-6">
				<div class="mx-auto max-w-2xl lg:mx-0">
					<h1 class="mt-24 text-4xl font-bold tracking-tight text-white sm:mt-10 sm:text-6xl">
						Ground screws
					</h1>
					<p class="mt-6 text-lg leading-8 text-white">
						Ground screws are an efficient foundation solutionfor various construction projects.
						They are quickly installed by being screwed into the ground, providing strong support
						for structures like decks, fences and solar panels. Ground screws reduce excavation
						needs, minimize soil disruption, and are less affected by weather conditions compared to
						traditional concrete foundations, making them an environmentally friendly and
						time-saving choice for many applications
					</p>
					<div class="mt-10 flex items-center gap-x-6">
						<a
							href="https://wa.me/13016055600"
							class="rounded-md bg-white px-3.5 py-2.5 text-sm font-semibold text-red-600 shadow-sm hover:bg-red-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
							target="_blank"
							rel="noopener noreferrer"
						>
							Get in touch
						</a>
					</div>
				</div>
			</div>
			<div class="relative lg:col-span-5 lg:-mr-8 xl:absolute xl:inset-0 xl:left-1/2 xl:mr-0">
				<AstroImage
					class="aspect-[3/2] w-full bg-gray-50 object-cover lg:absolute lg:inset-0 lg:aspect-auto lg:h-full"
					src={groundScrewBanner}
					alt="Ground Screws Banner"
					width={800}
					height={600}
					format="webp"
					quality={85}
				/>
			</div>
		</div>
	</div>

	<!-- <Headercategory
        title="Ground screws"
        content=" Ground screws are an efficient foundation solutionfor various construction projects. They are quickly installed by being screwed into the ground, providing strong support for structures like decks, fences and solar panels. Ground screws reduce excavation needs, minimize soil disruption, and are less affected by weather conditions compared to traditional concrete foundations, saving both time and costs."
        imglink="/images/header-screw-banner.png"
    /> -->

	<div class="bg-slate-100 py-24 sm:py-12">
		<div class="mx-auto container px-4 lg:px-8">
			<div class="mx-auto max-w-2xl lg:mx-0 lg:hidden xl:hidden">
				<div class="flex h-12 items-center justify-between">
					<div
						class="flex items-center justify-start gap-4 rounded-lg border border-gray-200 bg-white p-3"
					>
						<div class="flex items-center justify-start gap-2">
							<div class="flex h-7 w-7 items-center justify-center px-1 pb-[3px] pt-1">
								<AstroImage 
									src={filterIcon} 
									alt="filter" 
									width={24}
									height={24}
								/>
							</div>
							<div class="text-center text-base font-medium leading-normal text-gray-700">
								Filter
							</div>
						</div>
					</div>
					<div
						class="flex items-center justify-start gap-4 rounded-lg border border-gray-200 bg-white p-3"
					>
						<div class="flex items-center justify-start gap-2">
							<div class="flex h-6 w-6 items-center justify-center px-[3px] py-1.5">
								<AstroImage 
									src={sortIcon} 
									alt="sort" 
									width={24}
									height={24}
								/>
							</div>
							<div class="text-center">
								<span style="text-gray-700 text-base font-medium  leading-normal"
									>Sort by:
								</span><span style="text-gray-700 text-base font-bold  leading-normal"
									>Highlight</span
								>
							</div>
						</div>
						<div class="flex h-6 w-6 origin-top-left rotate-90 items-center justify-center">
							<div class="relative h-6 w-6"></div>
						</div>
					</div>
				</div>
			</div>
			<div
				class="grid grid-cols-1 gap-y-4 pt-5 sm:grid-cols-2 sm:gap-x-6 sm:gap-y-10 lg:grid-cols-2 lg:gap-x-4"
			>
				{
					Products.map((product) => (
						<div class="inline-flex h-40 items-start justify-start rounded-[10px] bg-white shadow">
							<div class="flex h-40 w-40 items-center justify-center p-2">
								<a href={`/ground-screws/${product.attributes.slug}/`}>
									<Image
										class="aspect-[1/1] shrink grow basis-0 self-stretch rounded-md object-cover"
										src={product.attributes.feature_image.data.attributes.url}
										alt={product.attributes.title}
										width={400}
										height={400}
									/>
								</a>
							</div>
							<div class="inline-flex shrink grow basis-0 flex-col items-start justify-start gap-1 px-4 py-3">
								<a href={`/ground-screws/${product.attributes.slug}/`}>
									<h1 class="self-stretch text-sm leading-tight text-gray-700">
										{product.attributes.title}
									</h1>
								</a>
								<div class="flex w-full flex-row items-center gap-1">
									<div class=" text-xs leading-3 text-black opacity-50">
										{product.attributes.category}
									</div>
								</div>
								<div class="h-5 self-stretch text-base font-bold leading-tight text-red-700">
									FROM ${product.attributes.price}
								</div>
								<div class="text-xs font-medium leading-3 text-black opacity-50">/ Per Unit</div>

								<div class="flex items-center justify-between self-stretch pt-1">
									<div class="text-xs font-medium leading-3 text-black opacity-50">MOQ: 500</div>
									<div class="text-xs font-medium leading-3 text-green-700">Ready to Ship</div>
								</div>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</div>
</Layout>
