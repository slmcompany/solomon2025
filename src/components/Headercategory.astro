---
const { title, content, imglink } = Astro.props;
---

<div class="bg-white pt-14 xl:hidden lg:hidden md:hidden">
    <img src={imglink} alt={title} class="w-full object-cover h-[40vh]" />
</div>
<div class="overflow-hidden bg-red-700 py-12 sm:py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div
            class="grid grid-cols-1 gap-x-12 gap-y-12 sm:gap-y-16 lg:grid-cols-2 lg:items-center"
        >
            <div class="px-4 lg:px-0 lg:pr-8">
                <div class="mx-auto max-w-2xl lg:mx-0 lg:max-w-xl">
                    <h1
                        class="text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl"
                    >
                        {title}
                    </h1>
                    <p class="mt-6 text-lg leading-8 text-white">
                        {content}
                    </p>
                </div>
            </div>
            <div class="hidden md:block">
              <div class="relative isolate overflow-hidden bg-red-700 px-6 pt-8 sm:rounded-3xl sm:px-10 sm:pt-12 lg:px-0">
                <div class="absolute -inset-y-px -left-3 -z-10 w-full origin-bottom-left skew-x-[-30deg] bg-indigo-100 opacity-20 ring-1 ring-inset ring-white" aria-hidden="true"></div>
                <div class="mx-auto max-w-2xl sm:mx-0 sm:max-w-none">
                  <img 
                    src={imglink} 
                    alt={title} 
                    width="2432" 
                    height="1442" 
                    class="-mb-12 w-full max-w-none rounded-xl bg-gray-800 ring-1 ring-white/10 shadow-2xl"
                  >
                </div>
                <div class="pointer-events-none absolute inset-0 ring-1 ring-inset ring-black/10 sm:rounded-3xl" aria-hidden="true"></div>
              </div>
            </div>
        </div>
    </div>
</div>
