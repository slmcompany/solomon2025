---
const locations = [
	{
		name: 'Export warehouse center',
		address: ' Kim Xuan street, Hoang Hoa District, Thanh Hoa Province, Viet Nam'
	},
	{
		name: 'Fabricated manufacturer factory',
		address: 'An Xa Industrial Park, Loc An Commune, Nam Dinh City, Viet Nam'
	},
	{
		name: 'Galvanizing factory',
		address: 'Dong Xuan Commune, Dong Hung District, Thai Binh Province, Viet Nam'
	}
]
---

<footer class="bg-gray-900" aria-labelledby="footer-heading">
	<div class="mx-auto max-w-7xl px-6 pb-8 pt-16 sm:pt-20 lg:px-8 lg:pt-16">
		<div class="xl:grid xl:grid-cols-2 xl:gap-12">
			<div class="space-y-8">
				<h1 class="text-3xl text-white font-semibold">SOLOMON INDUSTRIES LLC</h1>
				<dl class="space-y-6 text-base leading-7 text-white">
					<div class="flex gap-x-4">
						<dd class="text-white font-medium">HEAD OFFICE</dd>
					</div>
					<div class="flex gap-x-4 items-center">
						<dt class="flex-none">
							<svg
								class="h-7 w-6 text-white"
								fill="none"
								viewBox="0 0 24 24"
								stroke-width="1.5"
								stroke="currentColor"
								aria-hidden="true"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z"
								></path>
							</svg>
						</dt>
						<dd class="text-white">
							8512 Dakota Dr, Gaithersburg MD 20877
						</dd>
					</div>
					<div class="flex gap-x-4 items-center">
						<dt class="flex-none">
							<span class="sr-only">Phone</span>
							<img src="/images/whatsapp-svgrepo-com.svg" class="h-7 w-6" />
						</dt>
						<dd>
							<a class="text-white hover:text-gray-300" href="https://wa.me/13016055600">+1 (301) 605-5600</a>
						</dd>
					</div>
					<div class="flex gap-x-4 items-center">
						<dt class="flex-none">
							<span class="sr-only">Email</span>
							<svg
								class="h-7 w-6 text-white"
								fill="none"
								viewBox="0 0 24 24"
								stroke-width="1.5"
								stroke="currentColor"
								aria-hidden="true"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
								></path>
							</svg>
						</dt>
						<dd>
							<a class="text-white hover:text-gray-300" href="mailto:hiep@solomonindustries.us">hiep@solomonindustries.us</a>
						</dd>
					</div>
				</dl>
			</div>
			<div class="mt-8 xl:mt-0">
				<div class="space-y-6">
					<div class="flex gap-x-4">
						<dd class="uppercase text-white font-medium">FACTORIES LOCATION</dd>
					</div>
					{
						locations.map((location) => (
							<div class="relative flex items-start space-x-3 rounded-lg p-4 hover:bg-gray-800/50 transition-colors">
								<div class="flex-shrink-0">
									<svg
										width="22"
										height="20"
										viewBox="0 0 22 20"
										fill="none"
										xmlns="http://www.w3.org/2000/svg"
										class="h-7 w-6 text-white"
									>
										<path
											d="M21.5 19.25C21.5 19.4489 21.421 19.6397 21.2803 19.7803C21.1397 19.921 20.9489 20 20.75 20H1.25C1.05109 20 0.860322 19.921 0.71967 19.7803C0.579018 19.6397 0.5 19.4489 0.5 19.25C0.5 19.0511 0.579018 18.8603 0.71967 18.7197C0.860322 18.579 1.05109 18.5 1.25 18.5H2V7.25C2 7.11072 2.03879 6.97418 2.11201 6.8557C2.18524 6.73722 2.29001 6.64147 2.41459 6.57918C2.53917 6.51689 2.67863 6.49052 2.81735 6.50303C2.95608 6.51554 3.08857 6.56643 3.2 6.65L8 10.25V7.25C8 7.11072 8.03879 6.97418 8.11201 6.8557C8.18524 6.73722 8.29001 6.64147 8.41459 6.57918C8.53917 6.51689 8.67863 6.49052 8.81735 6.50303C8.95608 6.51554 9.08857 6.56643 9.2 6.65L12.8319 9.37344L13.9156 1.78813C13.9681 1.43127 14.1468 1.10506 14.4193 0.868712C14.6917 0.632364 15.0399 0.501544 15.4006 0.5H17.0994C17.4601 0.501544 17.8083 0.632364 18.0807 0.868712C18.3532 1.10506 18.5319 1.43127 18.5844 1.78813L19.9906 11.6441C19.9906 11.6441 19.9981 11.7172 19.9981 11.75V18.5H20.7481C20.8468 18.4998 20.9445 18.519 21.0357 18.5566C21.1269 18.5941 21.2098 18.6493 21.2797 18.719C21.3495 18.7887 21.4049 18.8714 21.4427 18.9626C21.4805 19.0537 21.5 19.1514 21.5 19.25ZM14.2006 10.4L15.0003 11H18.3856L17.0994 2H15.4006L14.2006 10.4ZM3.5 18.5H18.5V12.5H14.75C14.5877 12.5 14.4298 12.4474 14.3 12.35L12.95 11.3375L9.5 8.75V11.75C9.5 11.8893 9.46121 12.0258 9.38799 12.1443C9.31476 12.2628 9.20999 12.3585 9.08541 12.4208C8.96083 12.4831 8.82137 12.5095 8.68265 12.497C8.54392 12.4845 8.41143 12.4336 8.3 12.35L3.5 8.75V18.5Z"
											fill="white"
										/>
									</svg>
								</div>
								<div class="min-w-0 flex-1">
									<div class="focus:outline-none">
										<p class="text-sm font-semibold capitalize text-white">{location.name}</p>
										<p class="mt-1 text-sm text-gray-300">{location.address}</p>
									</div>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</div>

		<div class="mt-12 border-t border-white/10 pt-8 md:flex md:items-center md:justify-between">
			<div class="flex items-center space-x-6 md:order-2">
			</div>
			<p class="mt-8 text-center text-sm leading-5 text-gray-400 md:order-1 md:mt-0">
				&copy; 2020 SOLOMON INDUSTRIES LLC. All rights reserved.
			</p>
		</div>
	</div>
</footer>
