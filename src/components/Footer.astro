---
const locations = [
	{
		name: 'Export warehouse center',
		address: ' Kim Xuan street, Hoang Hoa District, Thanh Hoa Province, Viet Nam'
	},
	{
		name: 'Fabricated manufacturer factory',
		address: 'An Xa Industrial Park, Loc An Commune, Nam Dinh City, Viet Nam'
	},
	{
		name: 'Galvanizing factory',
		address: 'Dong Xuan Commune, Dong Hung District, Thai Binh Province, Viet Nam'
	}
]

const links = [
	{
		title: 'Links',
		items: [
			{ name: 'Home', href: '/' },
			{ name: 'About', href: '/about-us' },
			{ name: 'Contact', href: '/contact-us' },
			{ name: 'Privacy Policy', href: '/privacy-policy' },
			{ name: 'Terms of Service', href: '/terms-of-service' },
			{ name: 'Cookie Policy', href: '/cookie-policy' }
		]
	},
	{
		title: 'Products',
		items: [
			{ name: 'Metal Casting', href: '/products/metal-casting' },
			{ name: 'Metal Fabrication', href: '/products/metal-fabrication' },
			{ name: 'Ground Screws', href: '/products/ground-screws' },
			{ name: 'Quartz Stone', href: '/products/quartz-stone' },
			{ name: 'Rubber', href: '/products/rubber' },
			{ name: 'Plywood', href: '/products/plywood' }
		]
	}
]
---

<footer class="bg-gray-900" aria-labelledby="footer-heading">
	<div class="mx-auto max-w-7xl px-6 pb-8 pt-16 sm:pt-20 lg:px-8 lg:pt-16">
		<div class="xl:grid xl:grid-cols-2 xl:gap-12">
			<div class="space-y-8">
				<h1 class="text-3xl text-white font-semibold">SOLOMON INDUSTRIES LLC</h1>
				<dl class="space-y-6 text-base leading-7 text-white">
					<div class="flex gap-x-4">
						<dd class="text-white font-medium">HEAD OFFICE</dd>
					</div>
					<div class="flex gap-x-4 items-center">
						<dt class="flex-none">
							<svg
								class="h-7 w-6 text-white"
								fill="none"
								viewBox="0 0 24 24"
								stroke-width="1.5"
								stroke="currentColor"
								aria-hidden="true"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z"
								></path>
							</svg>
						</dt>
						<dd class="text-white">
							8512 Dakota Dr, Gaithersburg MD 20877
						</dd>
					</div>
					<div class="flex gap-x-4 items-center">
						<dt class="flex-none">
							<span class="sr-only">Phone</span>
							<img src="/images/whatsapp-svgrepo-com.svg" class="h-7 w-6" />
						</dt>
						<dd>
							<a class="text-white hover:text-gray-300" href="https://wa.me/13016055600">+1 (301) 605-5600</a>
						</dd>
					</div>
					<div class="flex gap-x-4 items-center">
						<dt class="flex-none">
							<span class="sr-only">Email</span>
							<svg
								class="h-7 w-6 text-white"
								fill="none"
								viewBox="0 0 24 24"
								stroke-width="1.5"
								stroke="currentColor"
								aria-hidden="true"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
								></path>
							</svg>
						</dt>
						<dd>
							<a class="text-white hover:text-gray-300" href="mailto:hiep@solomonindustries.us">hiep@solomonindustries.us</a>
						</dd>
					</div>
				</dl>
			</div>
			<div class="mt-8 xl:mt-0">
				<div class="grid grid-cols-2 gap-8">
					{links.map((section) => (
						<div>
							<h3 class="text-sm font-semibold leading-6 text-white">{section.title}</h3>
							<ul role="list" class="mt-6 space-y-4">
								{section.items.map((item) => (
									<li>
										<a href={item.href} class="text-sm leading-6 text-gray-300 hover:text-white">
											{item.name}
										</a>
									</li>
								))}
							</ul>
						</div>
					))}
				</div>
			</div>
		</div>

		<div class="mt-12 border-t border-white/10 pt-8 md:flex md:items-center md:justify-between">
			<div class="flex items-center space-x-6 md:order-2">
			</div>
			<p class="mt-8 text-center text-sm leading-5 text-gray-400 md:order-1 md:mt-0">
				© 2025 SOLOMON INDUSTRIES LLC. ALL RIGHTS RESERVED.
			</p>
		</div>
	</div>
</footer>
