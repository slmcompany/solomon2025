---
const { products, featuretitle } = Astro.props;
---

<div class="bg-slate-100 pb-28">
    <div class="pt-6 py-4">
        <div class="container mx-auto">
            <h1 class="text-3xl md:text-4xl lg:text-6xl text-red-700 py-5 md:py-10 text-left px-6 whitespace-nowrap overflow-hidden text-ellipsis block sm:hidden font-bold">
                {featuretitle}
            </h1>
            <h1 class="text-4xl md:text-5xl lg:text-6xl text-red-700 py-10 text-left ml-0 px-6 hidden sm:block lg:hidden font-bold">
                {featuretitle}
            </h1>
            <h1 class="text-6xl text-red-700 py-10 text-center mx-auto hidden lg:block font-bold">
                {featuretitle}
            </h1>
        </div>
        <div class="container mx-auto px-6 lg:px-8">
            <ul
                role="list"
                class="flex overflow-x-auto gap-4 pb-4 snap-x snap-mandatory sm:grid sm:grid-cols-1 sm:overflow-visible md:grid-cols-3 xl:grid-cols-6 xl:gap-4"
            >
                {
                    products.map((product: any) => (
                        <li class="rounded-2xl bg-red-700 xl:px-2 xl:py-2 px-2 py-2 flex-shrink-0 w-[80%] snap-center sm:w-full">
                            <ul
                                role="list"
                                class="my-2 flex justify-between gap-x-2"
                            >
                                {/* <li>
                                        <ul
                                            role="list"
                                            class=" flex justify-between gap-x-1 "
                                        >
                                            <li>
                                                <button
                                                    type="button"
                                                    class={`inline-flex text-white `}
                                                >
                                                    text
                                                </button>
                                            </li>
                                            <li>
                                                <button
                                                    type="button"
                                                    class={`inline-flex items-center gap-x-1.5 rounded-lg px-2.5 py-1.5 xl:text-sm text-md font-semibold text-white shadow-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2`}
                                                >
                                                   TExt
                                                </button>
                                            </li>
                                        </ul>
                                    </li> */}
                                <li>
                                    <button
                                        type="button"
                                        class="  px-2.5 py-1.5 xl:text-xl text-xl font-semibold "
                                    />
                                </li>
                            </ul>
                            <a href={product.link}>
                                <img
                                    class="rounded-2xl mx-auto aspect-[1/1] w-full "
                                    src={product.imageSrc}
                                    alt=""
                                />
                            </a>

                            <div class="w-full rounded-md text-center py-1">
                                <h1
                                    class="text-base text-white font-semibold"
                                >
                                    {product.title}
                                </h1>
                            </div>
                            <div class="divide-y divide-gray-100 text-xs leading-6">
                                {product.highlight.map((highlight: any) => (
                                    <ul
                                        role="list"
                                        class="mt-1 flex justify-between gap-x-4"
                                    >
                                        <li>
                                            <h3 class="text-sm leading-6 tracking-tight">
                                                {highlight.text}
                                            </h3>
                                        </li>
                                        <li>
                                            <p class="text-sm text-right leading-6">
                                                {highlight.value}
                                            </p>
                                        </li>
                                    </ul>
                                ))}
                            </div>
                            {/* <ul
                                role="list"
                                class="mt-6 flex justify-between  gap-x-3"
                            >
                                <li class="w-2/3">
                                    <a href={`/`}>
                                        <button
                                            type="button"
                                            class="bg-white border-red-600 w-full xl:text-lg text-red-600 inline-flex items-center gap-x-1.5 rounded-xl border-2 px-2.5 py-1.5 text-lg font-semibold justify-center"
                                        >
                                            {product.price}
                                        </button>
                                    </a>
                                </li>
                                <li class="w-full">
                                    <a href={product.link}>
                                        <button
                                            type="button"
                                            class="w-full xl:text-lg bg-red-600 inline-flex items-center gap-x-1.5 rounded-xl border-2 px-2 py-1.5 text-lg font-semibold text-white justify-center"
                                        >
                                           
                                           {product.price}
                                        </button>
                                    </a>
                                </li>
                            </ul> */}
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</div>
