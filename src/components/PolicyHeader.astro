---
interface Props {
	title: string;
	subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="bg-red-600 px-6 py-16 sm:py-24">
	<div class="mx-auto max-w-7xl">
		<div class="text-center">
			<h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{title}</h1>
			{subtitle && <p class="mt-4 text-lg leading-8 text-white/80">{subtitle}</p>}
		</div>
	</div>
</div> 